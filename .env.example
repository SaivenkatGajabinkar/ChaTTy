# Backend Environment Variables
# These must be set in your deployment environment (e.g., Render)

# Connection string for your free PostgreSQL database (from Neon.tech or Supabase)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# JWT Secret for encrypting tokens (Must be at least 32 characters long)
JWT_SECRET=your_super_secret_jwt_key_that_is_long_enough
JWT_EXPIRATION_MS=86400000

# Google Cloud Translation API Key (Leave empty to use free fallback)
GOOGLE_CLOUD_API_KEY=

# CORS Origins (Comma separated URLs allowed to access the backend)
CORS_ORIGIN=https://frontend-henna-three-32.vercel.app,http://localhost:5173

# Frontend Environment Variables (Place in frontend/.env)
# VITE_API_URL=https://chatty-backend-your-url.onrender.com
